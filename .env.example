# Quant Dynamics — Environment Configuration
# Copy this file to .env and adjust values for your setup.
# Do not commit .env to version control.

# Ensemble weights
ENSEMBLE_METHOD=stacking
ENSEMBLE_META_LEARNER=ridge
ENSEMBLE_WEIGHTS_JSON={"xgboost_reg": 0.2, "lightgbm_reg": 0.2, "rf_reg": 0.2, "lstm_reg": 0.2, "itransformer_reg": 0.2}

# Triple Barrier
TB_UPPER_BARRIER=0.05
TB_LOWER_BARRIER=-0.05
TB_TIME_HORIZON=168

# Meta-Label
META_LABEL_THRESHOLD=0.55

# Bayesian Updating
BAYES_PRIOR_UP=0.5
BAYES_REGIME_RATES={"bull": 0.60, "sideways": 0.50, "bear": 0.40}
BAYES_DECAY=0.95
BAYES_MIN_LR=1.1
BAYES_MAX_CONF_WEIGHT=3.0

# Regime-Specific Trading Parameters
REGIME_PARAMS_JSON={"bull": {"stop_loss_pct": 0.03, "take_profit_pct": 0.06, "risk_per_trade": 0.02, "trailing_stop_pct": 0.015, "max_concurrent_trades": 2}, "sideways": {"stop_loss_pct": 0.03, "take_profit_pct": 0.05, "risk_per_trade": 0.01, "trailing_stop_pct": 0.02, "max_concurrent_trades": 1}, "bear": {"stop_loss_pct": 0.03, "take_profit_pct": 0.05, "risk_per_trade": 0.01, "trailing_stop_pct": 0.02, "max_concurrent_trades": 1}}

# Backtest Risk Management
BT_RISK_PER_TRADE=0.02
BT_STOP_LOSS=0.03
BT_TAKE_PROFIT=0.06
BT_MAX_DD=0.15
BT_MAX_TRADES=1
BT_TRAILING_STOP=0.015
